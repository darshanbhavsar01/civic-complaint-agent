# ---- Gemini (AI Studio keys -> no GCP billing for AI) ----
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_ai_studio_key_here
# Optional second key, used automatically when the primary is out of quota.
GOOGLE_API_KEY_BACKUP=your_backup_key_here

# First model tried; the chain below is walked when one is exhausted or down.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-2.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest

# ---- Maps Platform: two separate keys ----
# Server key: restrict to Geocoding API only, cap ~300 req/day
MAPS_SERVER_KEY=your_geocoding_key_here
# Browser key: restrict to Maps Embed API + HTTP referrer = your Cloud Run URL
MAPS_EMBED_KEY=your_embed_key_here

# ---- Data backend: json (local/offline) or firestore (Cloud Run) ----
STORE=json

# ---- Demo hardening: canned vision results for the demo photos ----
DEMO_CACHE=0

# ---- Absolute base URL, used in social draft image links ----
PUBLIC_BASE_URL=http://localhost:8080
